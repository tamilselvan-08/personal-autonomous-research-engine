# Copy to .env (scripts/setup-env.ps1 or scripts/setup-env.sh does this and fills in secrets).
# Never commit .env.

# --- Secrets (required) -----------------------------------------------------
# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Signs session tokens. At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
# Set to false after creating your account to prevent new local sign-ups.
ALLOW_REGISTRATION=true
LOG_LEVEL=INFO

# --- Ports and URLs (change if 3000/8000 are taken) ---------------------------
WEB_PORT=3000
API_PORT=8000
# The URL your browser uses to reach the API. Compiled into the web bundle at build time.
PUBLIC_API_URL=http://localhost:8000
# Must include the web app's origin exactly (scheme://host:port).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Running the API outside Docker (apps/api reads these from apps/api/.env) ----
# DATABASE_URL=postgresql+psycopg://pare:<POSTGRES_PASSWORD>@localhost:5432/pare
